      "note": "Locked armory in the back."
    },
    {
      "id": "plaza",
      "name": "Plaza Mayor",
      "kind": "shelter",
      "col": 12,
      "row": 2,
      "note": "Trees, a fountain, a church on the north side."
    },
    {
      "id": "hospital",
      "name": "St. Ines Hospital",
      "kind": "hospital",
      "col": 17,
      "row": 7,
      "note": "Distress beacon active. Front gate on the avenue; ambulance bay round the back."
    },
    {
      "id": "pharmacy",
      "name": "Duarte's Pharmacy",
      "kind": "shelter",
      "col": 14,
      "row": 11,
