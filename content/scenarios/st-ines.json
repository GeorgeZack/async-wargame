  "features": [
    {
      "id": "lz",
      "name": "Red Beach",
      "kind": "beachhead",
      "col": 4,
      "row": 8,
      "note": "Landing zone. Halyard holds just offshore and takes everyone brought here."
    },
    {
      "id": "port",
      "name": "Harbor cranes",
      "kind": "port",
      "col": 6,
      "row": 3,
      "note": "Quays, sheds, and a fishing boat tied up at the slip."
    },
    {
      "id": "lock",
      "name": "Lock footbridge",
      "kind": "utility",
      "col": 9,
      "row": 2,
      "note": "One person wide. A stretcher won't fit."
    },
    {
      "id": "bridge",
