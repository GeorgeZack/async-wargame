    },
    {
      "id": "mast",
      "name": "Signal Hill mast",
      "kind": "relay",
      "col": 21,
      "row": 5,
      "note": "The city's radio mast. No power."
    }
  ],
  "units": [
    {
      "id": "m1",
      "brief": "You have the squad and the radio. Halyard's pilot, Lt. Marsh, will hold for three hours and not a minute longer: after that the tide turns and the dropship has to lift. Company wants the beacon's source found. You have not told the squad that the beacon uses a staff code: whoever set it off works at the hospital, and Company wants them out above anyone else.",
      "name": "Sgt. Reyes",
      "class": "sergeant",
      "col": 4,
      "row": 8,
      "strength": 1
    },
    {
      "id": "m2",
      "brief": "Your sister's girlfriend, Ana, is a nurse at St. Ines. You haven't heard from her in two days. Nobody in the squad knows, and you'd like it to stay that way. You know the old city a little from shore leave: the pharmacy on Calle Duarte has steel shutters and a back way through the alley.",
      "name": "LCpl. Okafor",
      "class": "rifleman",
      "col": 4,
      "row": 8,
      "strength": 1
    },
    {
      "id": "m3",
      "brief": "You carry the gun and four belts. Belt-fed fire carries a long way in empty streets, and you've heard what the infected do when they hear it. You also carry the breaching charge: two of them, actually. The second one isn't on the manifest.",
      "name": "PFC Doyle",
      "class": "gunner",
      "col": 4,
      "row": 8,
      "strength": 1
    },
    {
      "id": "m4",
      "brief": "You carry the squad's only medical kit and four doses of the antiviral the brass swear works if given within the hour of a bite. They've never told anyone it works after that. Company earmarked three of them for whoever set off the beacon. Who gets the fourth is up to you.",
      "name": "HM3 Lin",
      "class": "corpsman",
      "col": 4,
      "row": 8,
      "strength": 1
    },
    {
